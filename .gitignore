# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Input footage, generated artifacts, and model weights are kept out of git.
# The directories themselves are tracked via .gitkeep so the layout is obvious.
data/*
!data/.gitkeep
out/*
!out/.gitkeep
models/*
!models/.gitkeep

